# ============================================================
# READSCAPE - MASTER ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
#
# This file documents environment variables used throughout
# the Readscape application.
#
# SETUP:
# 1. Copy the variables needed by your service into its
#    existing local .env file or environment configuration.
# 2. Replace placeholder values with actual credentials.
# 3. Never commit real API keys, passwords, or secrets.
# 4. This .env.example file is safe to commit to GitHub.

# 1. DATABASE - NEON POSTGRESQL  
DB_USERNAME=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# 2. JWT Authentication
# Used by Spring Boot

JWT_SECRET=YOUR_JWT_SECRET
JWT_EXPIRATION=86400000

# 3. Google OAUTH 2.0
# Used by Spring Boot
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# 4. Google Gemini AI
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash

# 5. Google Books API
# Used by Node backend, insert google books api key
GOOGLE_BOOKS_API_KEY=GOOGLE_BOOKS_API_KEY

# 6. Internal Service Authentication
# Used by Spring Boot and Node backend
# Shared internal API key
INTERNAL_API_KEY=YOUR_INTERNAL_API_KEY

# 7. Spring Boot Configuration
# Used by Spring Boot
SPRING_PORT=8080
APP_FRONTEND_URL=http://localhost:5173

# 8. Node.js / Express Backend
# Used by Node backend
NODE_ENV=development
PORT=3001
SPRING_API_URL=http://localhost:8080

# 9. React / Vite Frontend
# Used by React frontend
# VITE_API_URL points to Node backend
# VITE_SPRING_API_URL points to Spring boot
VITE_API_URL=http://localhost:3001
VITE_SPRING_API_URL=http://localhost:8080



